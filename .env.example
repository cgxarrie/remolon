# Copy to .env and fill in. Do not commit .env.
#
# The JWT placeholder CHANGE_THIS_SECRET_KEY_MIN_32_CHARS_LONG_!! and the
# password retro_password were committed historically and are burned. Do not
# reuse them on any existing or production deploy. Generate new values.
#
# JWT_KEY must be at least 32 characters.

POSTGRES_PASSWORD=
JWT_KEY=

# SMTP auth (leave empty when using Mailpit). Do not set EMAIL_SMTP_HOST,
# EMAIL_SMTP_PORT, EMAIL_SMTP_ENABLE_SSL, or EMAIL_FROM unless you want to
# override Mailpit — empty values disable Compose defaults.
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=

# cdmon mailbox (replace yourdomain.com). Port 25 is closed; use 587 + STARTTLS.
# Port 465 does not work: System.Net.Mail.SmtpClient only speaks STARTTLS, not
# the implicit TLS that 465 requires. Username is the full email address.
# EMAIL_SMTP_HOST=smtp.yourdomain.com
# EMAIL_SMTP_PORT=587
# EMAIL_SMTP_ENABLE_SSL=true
# EMAIL_SMTP_USER=noreply@yourdomain.com
# EMAIL_SMTP_PASSWORD=
# EMAIL_FROM=ReMolon <noreply@yourdomain.com>

# These EMAIL_* names are mapped to Email__* by docker-compose.yml only. Outside
# Compose (Railway, or any plain Dockerfile deploy) set Email__SmtpHost,
# Email__SmtpPort, Email__EnableSsl, Email__SmtpUser, Email__SmtpPassword and
# Email__From on the service instead, plus Email__FrontendBaseUrl for links.
# Railway Hobby/Trial/Free also block outbound SMTP.

# Optional. Semicolon-separated hosts for the API when using docker-compose.tls.yml
# with a real DNS name. Default is localhost;127.0.0.1
# ALLOWED_HOSTS=localhost;127.0.0.1;example.com

# Optional. nginx proxy target for /api and /hubs. Must be a full URL: the
# http:// prefix is required, with no trailing slash and no path.
# Compose default is http://backend:8080.
# On Railway set this on the frontend service to the private backend, e.g.
# http://backend.railway.internal:8080
# BACKEND_UPSTREAM=http://backend:8080

# Optional. DNS server nginx uses to resolve BACKEND_UPSTREAM on each request.
# Compose default is Docker embedded DNS. On Railway use: [fd12::10] ipv6=on valid=1s
# NGINX_RESOLVER=127.0.0.11 ipv6=off valid=10s

